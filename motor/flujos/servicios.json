    {
      "id": "97d1d927-f344-4f42-b528-2d146c11d42d",
      "name": "Probar clave de Gemini",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        800
      ],
      "parameters": {
        "jsCode": "// Comprueba la clave de Gemini y elige los mejores modelos gratuitos disponibles\nconst datos = $input.first().json.body || {};\nconst api = 'https://generativelanguage.googleapis.com/v1beta';\nconst clave = String(datos.clave || '').trim();\n\nif (!clave) return [{ json: { ok: true, datos, modelo: '' } }];   // solo actualiza nombre o \"sobre mí\"\n\nlet r;\ntry {\n  r = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${api}/models?pageSize=1000`,\n    headers: { 'x-goog-api-key': clave },\n    json: true,\n    timeout: 20000,\n    returnFullResponse: true,\n    ignoreHttpStatusErrors: true,\n  });\n} catch (err) {\n  return [{ json: { ok: false, error: 'No pude llegar a Google. Revisa la conexión a internet.' } }];\n}\nif (r.statusCode !== 200) {\n  return [{ json: { ok: false, error: 'Google rechazó la clave. Revisa que la copiaste completa (empieza por AIza).' } }];\n}\n\nconst nombres = (r.body.models || [])\n  .filter((m) => (m.supportedGenerationMethods || []).includes('generateContent'))\n  .map((m) => String(m.name).replace(/^models\\//, ''));\n\n// Solo modelos \"flash\" de texto: rápidos y con plan gratuito\nconst candidatos = nombres.filter((n) => /^gemini-\\d+(\\.\\d+)?-flash/.test(n) && !/(image|tts|audio|live|native|thinking|exp|robotics|computer)/.test(n));\nconst version = (n) => parseFloat((n.match(/^gemini-(\\d+(?:\\.\\d+)?)/) || [])[1] || '0');\nconst puntaje = (n) => {\n  let s = version(n) * 10;\n  if (/-lite/.test(n)) s -= 100;            // los \"lite\" quedan de respaldo\n  if (/preview/.test(n)) s -= 8;            // preferir versiones estables\n  if (/-\\d{2,3}(-\\d{2})?$/.test(n)) s -= 1; // sin fecha al final es mejor\n  return s;\n};\nlet modelos = [...new Set(candidatos)].sort((a, b) => puntaje(b) - puntaje(a) || a.length - b.length).slice(0, 4);\nif (!modelos.length && nombres.includes('gemini-flash-latest')) modelos = ['gemini-flash-latest'];\nif (!modelos.length) return [{ json: { ok: false, error: 'La clave funciona, pero no tiene acceso a modelos Gemini Flash.' } }];\n\nreturn [{ json: { ok: true, modelo: modelos[0], datos: { ...datos, clave, modelos } } }];\n"
      }
    },
